# Local-only Docker Compose configuration. Safe defaults; do not use in production.
# Host-side scripts can connect through localhost:5433. Compose services override
# DATABASE_URL to use the internal `db` service name.
DATABASE_URL=postgresql+psycopg://quantcore:quantcore_local_only@127.0.0.1:5433/quantcore
SECRET_KEY=local-development-only-change-me
ENVIRONMENT=development
PRODUCTION_DATA_POLICY_ENFORCED=false
FMP_API_KEY=
FRED_API_KEY=
MASSIVE_API_KEY=
SEC_USER_AGENT=QuantCore/1.0 local-development
MARKET_DATA_PROVIDER=yahoo
FINANCIAL_DATA_PROVIDER=fmp
REALTIME_MARKET_DATA_PROVIDER=fmp
REGULATORY_DATA_PROVIDER=sec
MACRO_DATA_PROVIDER=fred
SQL_ECHO=false
LOG_LEVEL=INFO
LOG_FORMAT=json
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE_SECONDS=1800
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_JWKS_URL=
AUTH_ALGORITHMS=RS256
AUTH_JWKS_CACHE_SECONDS=300
QUANTCORE_INGESTION_SCHEDULES_JSON=[]
QUANTCORE_POSTGRES_PORT=5433
QUANTCORE_API_PORT=8000
