# Copy to a secret-managed environment file outside the repository.
# Do not commit the populated file.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/quantcore
SECRET_KEY=replace-with-a-long-random-secret
ENVIRONMENT=production
PRODUCTION_DATA_POLICY_ENFORCED=true

FINANCIAL_DATA_PROVIDER=sec
REGULATORY_DATA_PROVIDER=sec
MACRO_DATA_PROVIDER=fred
MARKET_DATA_PROVIDER=massive
REALTIME_MARKET_DATA_PROVIDER=massive

MASSIVE_API_KEY=replace-with-massive-api-key
SEC_USER_AGENT=QuantCore/1.0 contact: ops@example.com

AUTH_ISSUER=https://issuer.example.com/
AUTH_AUDIENCE=quantcore-api
AUTH_JWKS_URL=https://issuer.example.com/.well-known/jwks.json
AUTH_ALGORITHMS=RS256
AUTH_JWKS_CACHE_SECONDS=300

# Declarative persistent ingestion schedules. Keep [] until the production
# ingestion cadence has been explicitly selected and capacity-tested.
# Example:
# QUANTCORE_INGESTION_SCHEDULES_JSON=[{"name":"daily-price-history","dataset":"price_history","interval_seconds":86400,"only_stale":true,"enabled":true}]
QUANTCORE_INGESTION_SCHEDULES_JSON=[]
